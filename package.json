{
  "name": "millionaire-city-private-server",
  "private": true,
  "version": "0.1.0",
  "description": "Private server and desktop launcher for Millionaire City 0.501",
  "main": "apps/desktop/dist/main.js",
  "author": "Millionaire City Revival contributors",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prebuild": "node scripts/checkDependencies.cjs tsc",
    "build": "cmd /c npm run build -w @mcity/shared && npm run build -w @mcity/server && npm run build -w @mcity/desktop",
    "predev:server": "node scripts/checkDependencies.cjs tsc tsx",
    "dev:server": "cmd /c npm run dev -w @mcity/server",
    "predev:desktop": "node scripts/checkDependencies.cjs tsc electron",
    "dev:desktop": "cmd /c npm run dev -w @mcity/desktop",
    "preprepare-client": "node scripts/checkDependencies.cjs tsx",
    "prepare-client": "cmd /c npm run prepare-client -w @mcity/server",
    "prepare-runtime": "node scripts/prepareReleaseRuntime.cjs",
    "prepackage:win": "node scripts/checkDependencies.cjs tsc tsx",
    "package:win": "cmd /c npm run prepare-client && npm run prepare-runtime && npm run build && npx --yes electron-builder@26.8.1 --win zip --x64 --publish never",
    "prepackage:win:dir": "node scripts/checkDependencies.cjs tsc tsx",
    "package:win:dir": "cmd /c npm run prepare-client && npm run prepare-runtime && npm run build && npx --yes electron-builder@26.8.1 --win dir --x64 --publish never",
    "report:missing-assets": "cmd /c npm run report:missing-assets -w @mcity/server",
    "pretest": "node scripts/checkDependencies.cjs tsc vitest",
    "test": "cmd /c npm run test -w @mcity/server",
    "typecheck": "cmd /c npx tsc -b packages/shared/tsconfig.json apps/server/tsconfig.json apps/desktop/tsconfig.json --pretty false",
    "lint:unused": "cmd /c npx knip --no-progress --workspace @mcity/server --workspace @mcity/desktop --workspace @mcity/shared --include files,exports --include-entry-exports",
    "lint:cycles": "cmd /c npx madge --extensions ts --circular apps/server/src apps/desktop/src packages/shared/src"
  },
  "dependencies": {
    "@mcity/shared": "^0.1.0",
    "better-sqlite3": "^11.10.0",
    "express": "^4.22.2",
    "selfsigned": "^3.0.1"
  },
  "build": {
    "appId": "com.millionairecity.rebuilt",
    "productName": "Millionaire City Rebuilt",
    "electronVersion": "10.4.7",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "package.json",
      "apps/desktop/dist/**/*",
      "apps/desktop/assets/**/*",
      "apps/server/dist/**/*",
      "apps/server/assets/**/*",
      "packages/shared/package.json",
      "packages/shared/dist/**/*",
      "assets/**/*",
      "generated/client/**/*",
      "generated/runtime/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MillionaireCityRebuilt-${version}-portable-win-${arch}.${ext}"
    }
  }
}
