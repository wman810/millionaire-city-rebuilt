{
  "name": "@mcity/server",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "scripts": {
    "prebuild": "node ../../scripts/checkDependencies.cjs tsc",
    "build": "npm run build -w @mcity/shared && tsc -p tsconfig.json",
    "predev": "node ../../scripts/checkDependencies.cjs tsc tsx",
    "dev": "npm run build -w @mcity/shared && tsx watch src/main.ts",
    "preprepare-client": "node ../../scripts/checkDependencies.cjs tsx",
    "prepare-client": "tsx src/scripts/prepareClient.ts",
    "prereport:missing-assets": "node ../../scripts/checkDependencies.cjs tsx",
    "report:missing-assets": "tsx src/scripts/reportMissingAssets.ts",
    "pretest": "node ../../scripts/checkDependencies.cjs tsc vitest",
    "test": "npm run build -w @mcity/shared && vitest run"
  },
  "dependencies": {
    "@mcity/shared": "0.1.0",
    "better-sqlite3": "^11.10.0",
    "express": "^4.22.2",
    "jquery": "3.7.1",
    "selfsigned": "^3.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.1",
    "tsx": "^4.22.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
